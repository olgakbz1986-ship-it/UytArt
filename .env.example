# ============================================================
# Quantiform server — пример переменных окружения (БЛОК 1, §1.1)
# Скопируйте в .env.server и заполните значениями. НЕ коммитить .env.*
# ============================================================

--- # Секреты и токены ---
JWT_SECRET=                       # обязательный в production (подпись JWT)
ACCESS_TOKEN_TTL_SEC=900          # access-токен: 15 минут (значение по умолчанию)
REFRESH_TOKEN_TTL_SEC=604800      # refresh-токен: 7 дней (значение по умолчанию)

--- # Supabase / PostgreSQL ---
SUPABASE_URL=
SUPABASE_ANON_KEY=                # клиентский ключ (публикуемый)
SUPABASE_SERVICE_ROLE_KEY=        # СЕРВЕРНЫЙ ключ, обходит RLS; НИКОГДА не отдавать клиенту
DATABASE_URL=                     # Yandex Managed PG / Supabase Postgres

--- # ЮKassa (эквайринг) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=          # секрет HMAC-SHA256 для проверки вебхуков (§3.2)

--- # Прочее ---
API_URL=http://localhost:8787
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Quantiform <no-reply@starttechpro.ru>

--- # Безопасность ИИ (БЛОК 4) ---
AI_MAX_INPUT_LEN=4000             # жёсткий лимит длины пользовательского ввода в LLM (§4.1)
AI_DESIGNER_PROVIDER=mock         # mock | gigachat | yandex | hybrid
AI_DESIGNER_RATE_MAX=10           # максимум AI-запросов в минуту на пользователя (§4.3)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
YANDEX_API_KEY=
